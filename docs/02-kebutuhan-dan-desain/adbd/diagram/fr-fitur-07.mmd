flowchart TD
  S(["Mulai"]) --> P["Prakondisi: bukti sudah terbit"]
  P --> L1["Membuka bukti"]
  L1 --> L2["Mengunduh atau meminta kirim"]
  L2 --> L3["Sistem menerbitkan message ke Kafka"]
  L3 --> L4["Membaca status"]
  L4 --> C{"Berhasil?"}
  C -- "Ya" --> H["Donatur menerima bukti"]
  C -- "Tidak" --> G["Pengiriman gagal; status tidak menjadi Terkirim"]
  P -. "alternatif" .-> T["Kanal WhatsApp belum berjalan; dikirim lewat email"]
  H --> E(["Selesai"])
  G --> E
