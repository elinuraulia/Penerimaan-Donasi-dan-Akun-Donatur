digraph v { node [shape=plaintext, fontname="Helvetica", fontsize=13];
 n [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="4" CELLPADDING="5" COLOR="#777777"><TR><TD COLSPAN="5" BORDER="0"><B>Aktivitas pendukung</B></TD></TR><TR><TD BGCOLOR="#f2f2f2" COLSPAN="5" WIDTH="750" HEIGHT="34">Tata kelola dan kepatuhan syariah</TD></TR><TR><TD BGCOLOR="#f2f2f2" COLSPAN="5" WIDTH="750" HEIGHT="34">Keuangan dan pembukuan</TD></TR><TR><TD BGCOLOR="#f2f2f2" COLSPAN="5" WIDTH="750" HEIGHT="34">Sumber daya manusia</TD></TR><TR><TD BGCOLOR="#cdeadb" COLSPAN="5" WIDTH="750" HEIGHT="34">Teknologi: notifikasi, akun staf, hak akses (P-07, P-08)</TD></TR><TR><TD COLSPAN="5" BORDER="0"><B>Aktivitas utama (kiri ke kanan)</B></TD></TR><TR><TD BGCOLOR="#ffffff" WIDTH="150" HEIGHT="62">Penghimpunan<BR/>dana</TD><TD BGCOLOR="#ffffff" WIDTH="150" HEIGHT="62">Pencatatan donasi<BR/>(Kelompok 1)</TD><TD BGCOLOR="#cdeadb" WIDTH="150" HEIGHT="62">Layanan donatur<BR/>(P-01 sampai P-05)</TD><TD BGCOLOR="#ffffff" WIDTH="150" HEIGHT="62">Pengelolaan dan<BR/>penyaluran</TD><TD BGCOLOR="#cdeadb" WIDTH="150" HEIGHT="62">Pelaporan kepada<BR/>donatur (P-04, P-06)</TD></TR><TR><TD COLSPAN="5" BORDER="0">Nilai: donatur percaya dan penerima manfaat terbantu</TD></TR></TABLE>>]; }
